  "backs": [ { "empleadoId": 7, "tipoRegistro": "JORNADA", "diasDescanso": 2, "fechaInicio": "2026-10-20", "fechaFin": "2026-10-23",
               "principalRelacionado": 1, "observacion": "Back de prueba" } ] }

