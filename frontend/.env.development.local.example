# Fase 7b: copiar como .env.development.local (ignorado por git, *.local) para probar Entra ID en localhost.
# Valores PÚBLICOS (no son secretos), pero se guardan fuera del repo mientras el pendiente 9 siga abierto.
# Para volver a DevAuth basta con borrar o renombrar .env.development.local (y quitar Autenticacion:Modo de los user-secrets).
VITE_AUTH_MODE=entra
VITE_ENTRA_TENANT_ID=[PENDIENTE: Id. de directorio (tenant) de SEDEMI]
VITE_ENTRA_CLIENT_ID=[PENDIENTE: Client ID de SIG-Profesiograma-SPA-DEV]
VITE_ENTRA_API_SCOPE=api://[PENDIENTE: Client ID de SIG-Profesiograma-API-DEV]/access_as_user
